{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komikhq-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.komikhq.dpdns.org",
      "custom_domain": true
    }
  ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  "kv_namespaces": [
    {
      "binding": "KV_KOMIKHQ",
      "id": "8e9495dce11d4e21a5103d30e96dddca"
    }
  ],
  "r2_buckets": [
    {
      "binding": "USERS_BUCKET",
      "bucket_name": "komikhq-users"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "komikhq-media"
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_PRESENCE_DO",
        "class_name": "GlobalPresenceDO"
      },
      {
        "name": "COMMENT_STREAM_DO",
        "class_name": "CommentStreamDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalPresenceDO",
        "CommentStreamDO"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

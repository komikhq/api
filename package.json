{
  "name": "komikhq-api",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.3.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "users": "tsx --tsconfig scripts/cli/tsconfig.json scripts/cli/users.tsx",
    "deploy": "wrangler deploy --minify",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:drop": "tsx scripts/drop-tables.ts",
    "db:migrate-relative-urls": "tsx scripts/migrate-relative-urls.ts",
    "db:studio": "drizzle-kit studio",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "openapi-generator": "openapi-generator-cli",
    "sdk:generate": "openapi-generator-cli generate -i http://localhost:8787/openapi.json -g typescript-fetch -o ./packages/sdk --additional-properties=npmName=@komikhq/sdk,typescriptThreePlus=true,supportsES6=true"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@neondatabase/serverless": "^1.1.0",
    "@scalar/hono-api-reference": "^0.12.11",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "pusher": "^5.3.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "drizzle-kit": "^0.31.10",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "prettier": "3.9.10",
    "react": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}